# =============================================================================
# TabiaERP Çivi ve Tel İmalat ERP — Ortam Değişkenleri Şablonu (.env.example)
# =============================================================================

# Sunucu Portu (Varsayılan: 3000)
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Gerçek sırlar yalnız .env içindedir. Bu dosya şablondur; parola ve anahtar buraya yazılmaz.
# PostgreSQL bağlantısı (Prisma). Kullanıcı, parola ve port kendi ortamınıza göre değiştirilir.
DATABASE_URL="postgresql://KULLANICI:PAROLA@127.0.0.1:5432/tabiaerp?schema=public"
POSTGRES_DOCKER_CONTAINER=tabiaerp-pg

# -----------------------------------------------------------------------------
# ⚠️ KRİTİK GÜVENLİK UYARISI: JWT SECRET VE SUNUCU GİZLİ ANAHTARLARI
# -----------------------------------------------------------------------------
# DİKKAT: JWT_SECRET ve JWT_REFRESH_SECRET anahtarları YALNIZCA sunucu tarafında
# (Node.js/Express) çalıştırılmalıdır. Bu anahtarlar ASLA frontend (istemci)
# kodlarına aktarılmamalı, Vite bundle'ına dahil edilmemeli, VITE_ ön eki
# verilmemeli ve React bileşenlerine import edilmemelidir!
# Aksi takdirde tüm JWT imzalama ve yetkilendirme güvenliği tehlikeye girer.
# -----------------------------------------------------------------------------
JWT_SECRET="degistiriniz_en_az_32_karakter_uzunlugunda_guvenli_uretim_anahtari"
JWT_REFRESH_SECRET="degistiriniz_en_az_32_karakter_uzunlugunda_refresh_anahtari"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@tabiaerp.local
SEED_ADMIN_PASSWORD=en_az_10_karakter_Buyuk_kucuk_rakam_ozel!

# İstemci Tarafı API URL (Boş bırakıldığında aynı host/port kullanılır)
VITE_API_URL=""

# İsteğe bağlı. Boşsa meslek listesi elle güncellenir.
SGK_MESLEK_URL=
TRUST_PROXY=0

# AI Studio Sistem Değişkenleri (Otomatik olarak AI Studio tarafından atanır)
GEMINI_API_KEY=""
APP_URL=""
