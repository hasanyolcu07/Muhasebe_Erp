  doviz     String  @default("TRY")
  acilis    Decimal @default(0) @db.Decimal(18, 2)
  isActive  Boolean @default(true) @map("is_active")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, kod])
  @@map("banka_hesaplari")
}

model NakitHareket {
