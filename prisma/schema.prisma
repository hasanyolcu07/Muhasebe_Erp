  @@index([companyId, tarih])
  @@map("yatirim_giderleri")
}

/// Ülke mevzuatı. Değer resmi kaynak doğrulanmadan yazılmaz.
/// Oranlar 1 = %100 olacak şekilde Decimal(18,6). Tutarlar TL.
model MevzuatParametre {
  id                  Int       @id @default(autoincrement())
  anahtar             String
  deger               Decimal   @db.Decimal(18, 6)
  gecerlilikBaslangic DateTime  @map("gecerlilik_baslangic") @db.Date
  gecerlilikBitis     DateTime? @map("gecerlilik_bitis") @db.Date
  kaynak              String
  createdAt           DateTime  @default(now()) @map("created_at")

  @@unique([anahtar, gecerlilikBaslangic])
  @@index([anahtar, gecerlilikBaslangic])
  @@map("mevzuat_parametreleri")
}

model OrtakDagitim {
